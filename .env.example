# Copiar a .env y ajustar. Ningun secreto real vive en el repositorio.
# Las credenciales de abajo son de desarrollo local y coinciden con las de
# docker-compose.yml.

NODE_ENV=development
TZ=UTC

# --- Base de datos (docker compose up -d) ---
# 5434 y no 5432 a proposito: en Windows es comun tener un PostgreSQL nativo
# u otro proyecto ocupando el 5432 o el 5433, y Prisma terminaria hablando con
# esa base sin avisar.
POSTGRES_USER=repunto
POSTGRES_PASSWORD=repunto_local
POSTGRES_DB=repunto
POSTGRES_PORT=5434
DATABASE_URL=postgresql://repunto:repunto_local@localhost:5434/repunto?schema=public
# Conexion directa, solo para las migraciones. En local no hace falta: es la
# misma de arriba. Con una base manejada detras de un pooler si, porque el
# pooler en modo transaccion no sostiene los candados que usa migrate.
# DIRECT_URL=

# --- Base manejada (Supabase) ---
# La app va por el pooler en modo transaccion; las migraciones y el seed, por
# la conexion directa. Los dos hosts los da Supabase en Settings -> Database;
# no se inventan, cambian por proyecto y por region.
#
# DATABASE_URL=postgresql://postgres.<ref>:<clave>@<host-del-pooler>:6543/postgres?sslmode=require&pgbouncer=true
# DIRECT_URL=postgresql://postgres:<clave>@db.<ref>.supabase.co:5432/postgres?sslmode=require
#
# Si al conectar aparece "self-signed certificate in certificate chain", el
# certificado no valida contra las CA del sistema: para staging, cambiar
# sslmode=require por sslmode=no-verify y anotarlo como deuda. Para produccion
# se descarga la CA de Supabase, no se apaga la verificacion.
# Base de los tests de integracion. pnpm test:integration la BORRA y la vuelve
# a crear en cada corrida, asi que el nombre tiene que terminar en _test y el
# host tiene que ser local: si no, los tests se niegan a arrancar.
DATABASE_URL_TEST=postgresql://repunto:repunto_local@localhost:5434/repunto_test

# --- apps/api ---
PORT=3001
APP_VERSION=0.1.0-dev

# Clave de cifrado de las semillas TOTP de los clientes (AES-256-GCM): 32
# bytes en base64. La de abajo es de juguete y esta a la vista a proposito:
# sirve para que un clon recien hecho corra los tests sin generar nada. En
# staging y en produccion va una distinta y de verdad, que no vive en el repo.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_CIFRADO_SEMILLAS=cmVwdW50by1kZXNhcnJvbGxvLWxvY2FsLTMyYnl0ZXM=

# Origenes de los frontends, separados por coma. Sin esto ningun navegador
# puede llamar a la api: CORS bloquea todas las rutas, no una. En produccion es
# obligatoria y la api no arranca sin ella, a proposito: el sintoma de que
# falte es un error de CORS en la consola de alguien, que no dice que falta una
# variable de entorno. Acepta comodin de subdominio para los previews del
# hosting: https://*.netlify.app
ORIGENES_PERMITIDOS=http://localhost:3000,http://localhost:3002

# --- apps/cliente y apps/panel ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# Sentry, Cloudflare R2 y WhatsApp Cloud API se agregan cuando se configuren.
# Variables vacias que nadie lee son ruido.
