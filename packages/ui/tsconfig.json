{
  // Sin build: cada app lo compila con su propio Next (`transpilePackages`).
  // Por eso apunta `exports` al codigo fuente, no a un dist, y este tsconfig
  // solo chequea tipos.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
