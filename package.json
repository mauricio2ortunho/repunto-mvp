{
  "name": "repunto",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de fidelizacion Repunto. Monorepo.",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0 && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --project unitarios",
    "test:cobertura": "vitest run --project unitarios --coverage",
    "test:integration": "vitest run --project integracion",
    "db:migrate": "prisma migrate dev && prisma generate",
    "db:generate": "prisma generate",
    "db:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON apps/api/scripts/seed.mts"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@types/node": "^24.5.2",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "prettier": "^3.6.2",
    "prisma": "^7.10.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.45.0",
    "vitest": "^3.2.4"
  }
}
