# Copiar a .env.local y ajustar. Este archivo lo lee Next.js desde ESTE
# directorio, no desde la raiz: el panel es su propia app.
#
# La api, en cambio, lee el .env de la raiz del repositorio. Las variables del
# servidor —DATABASE_URL, CLAVE_CIFRADO_SEMILLAS, ORIGENES_PERMITIDOS— viven
# ahi, en .env.example, no aca.

# Donde contesta la api. Sin barra al final.
# Obligatoria. En el hosting es la URL publica del proyecto de la api.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Donde contesta la app del cliente. Sin barra al final. Con ella se arma el
# QR que se imprime para cada local. Obligatoria fuera de `next dev`: sin
# ella, la hoja del QR no dibuja nada.
NEXT_PUBLIC_URL_CLIENTE=http://localhost:3000

# No hay token de tablet en el entorno: cada tablet obtiene el suyo en
# /vincular (docs/despliegue.md, 3b). En `next dev`, .env.development trae el
# de la tablet de demo del seed, para no vincular el navegador de desarrollo
# cada vez; en cualquier build esa variable se ignora (lib/configuracion.ts).

# Sentry: los errores del navegador de la tablet. El DSN del proyecto
# repunto-panel (no es un secreto: termina en el bundle). Sin el, el panel
# anda igual y no avisa nada; en `next dev` conviene dejarlo vacio.
NEXT_PUBLIC_SENTRY_DSN=
# staging o produccion: dice de que entorno es cada error.
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
